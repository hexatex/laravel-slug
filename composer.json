{
    "name": "hexatex/laravel-slug",
    "description": "Adds the abililty to assign slugs to models.",
    "license": "MIT",
    "authors": [
        {
            "name": "Cory Baumer",
            "email": "cory.j.baumer@gmail.com",
            "homepage": "https://github.com/hexatex"
        }
    ],
    "homepage": "https://github.com/hexatex/laravel-slug",
    "keywords": ["Laravel", "LaravelSlug"],
    "require": {
        "illuminate/support": "~9"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.0",
        "orchestra/testbench": "^7.30",
        "nunomaduro/collision": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "Hexatex\\LaravelSlug\\": "src/",
            "Hexatex\\LaravelService\\": "../laravel-service/src/",
            "Hexatex\\PhpMisc\\": "../php-misc/src/",
            "Hexatex\\LaravelUser\\": "../laravel-user/src/",
            "Hexatex\\LaravelFiltered\\": "../laravel-filtered/src/",
            "Hexatex\\LaravelValidation\\": "../laravel-validation/src/",
            "Hexatex\\LaravelMisc\\": "../laravel-misc/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hexatex\\LaravelSlug\\Tests\\": "tests",
            "Hexatex\\LaravelSlug\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hexatex\\LaravelSlug\\LaravelSlugServiceProvider"
            ],
            "aliases": {
                "LaravelSlug": "Hexatex\\LaravelSlug\\Facades\\LaravelSlug"
            }
        }
    }
}
